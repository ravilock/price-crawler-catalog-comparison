{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-read-result.v1.schema.json",
  "allOf": [
    {
      "$ref": "message-envelope.v1.schema.json"
    },
    {
      "properties": {
        "message_type": {
          "const": "candidate.read.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "offer_id": {
              "type": "string",
              "format": "uuid"
            },
            "crawl_request_id": {
              "type": "string",
              "format": "uuid"
            },
            "candidate_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "found",
                "pending",
                "not_found",
                "forbidden"
              ]
            },
            "candidate": {
              "type": "object",
              "properties": {
                "offer_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "crawl_request_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "candidate_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "normalization_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "fields": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                    },
                    "description": {
                      "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                    },
                    "brand": {
                      "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                    },
                    "manufacturer_model": {
                      "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                    },
                    "gtin": {
                      "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                    }
                  },
                  "required": [
                    "title",
                    "description",
                    "brand",
                    "manufacturer_model",
                    "gtin"
                  ],
                  "additionalProperties": false
                },
                "attributes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "value": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      "unit": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 100
                      },
                      "field": {
                        "$ref": "product-information-found.v1.schema.json#/$defs/field_candidate"
                      }
                    },
                    "required": [
                      "name",
                      "value",
                      "unit",
                      "field"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "evidence_expired": {
                  "type": "boolean"
                }
              },
              "required": [
                "offer_id",
                "crawl_request_id",
                "candidate_id",
                "normalization_version",
                "fields",
                "attributes",
                "evidence_expired"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "offer_id",
            "crawl_request_id",
            "candidate_id",
            "status"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "found"
                  }
                }
              },
              "then": {
                "required": [
                  "candidate"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "candidate"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
